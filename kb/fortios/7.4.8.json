  "items": [
    {
      "id": "7.4.8-SN-ztna-smb",
      "section": "special_notice",
      "dedupe": "sn:smb-drive-mapping-with-ztna-access-proxy",
      "introduced": "7.4.1",
      "title": "ZTNA アクセスプロキシ経由の SMB ドライブが再起動後に使えない",
      "summary": "7.4.1 から、ZTNA アクセスプロキシの TCP フォワーディングを FQDN で設定していると、Windows PC の再起動後に SMB のドライブ割り当てが使えなくなる。IP で設定していれば起きない。",
      "severity": "low",
      "when": {
        "path": "firewall access-proxy[*] api-gateway[*]",
        "key": "service",
        "op": "eq",
        "value": "tcp-forwarding"
      },
      "judge": "ai",
      "ai": {
        "question": "TCP フォワーディングのアクセスプロキシで、SMB（445）のサーバーを FQDN のアドレスで指定していますか？",
        "context": [
          "firewall access-proxy",
          "firewall address"
        ]
      },
      "impact": "ZTNA 経由で割り当てた SMB のドライブに、PC の再起動後につながらない。",
      "action": "Windows の資格情報マネージャーに domain\\username の形で資格情報を入れるか、KDC プロキシで Kerberos のチケットを出す。",
      "url": "https://docs.fortinet.com/document/fortigate/7.4.8/fortios-release-notes/832119/smb-drive-mapping-with-ztna-access-proxy"
    },
    {
      "id": "7.4.8-SN-ecmp-local-out",
      "section": "special_notice",
      "dedupe": "sn:local-out-traffic-using-ecmp-routes-could-use-different-port-or-route-to-server",
      "introduced": "7.4.1",
      "title": "ECMP があると自機発の通信の出口が変わることがある",
      "summary": "7.4.1 から、ECMP のルートがあると、FortiGate 自身が出す通信（FortiGuard・ログ送信など）が別のポート・ルートを使うことがある。",
      "severity": "medium",
      "when": {
        "any": [
          {
            "path": "router static[*]"
          },
          {
            "path": "system sdwan",
            "key": "status",
            "op": "eq",
            "value": "enable"
          }
        ]
      },
      "judge": "ai",
      "ai": {
        "question": "同じ宛先へ、距離と優先度が同じルート（ECMP）が複数ありますか（SD-WAN のメンバーを含む）？",
        "context": [
          "router static",
          "system sdwan"
        ]
      },
      "impact": "送信元の IP が変わり、相手側で送信元を絞っている通信（ログ・認証・管理など）が失敗することがある。",
      "action": "送信元の IP が大事な自機発の通信は、interface-select-method specify と interface で出口を決める（例：system fortiguard）。",
      "url": "https://docs.fortinet.com/document/fortigate/7.4.8/fortios-release-notes/421162/local-out-traffic-using-ecmp-routes-could-use-different-port-or-route-to-server"
    },
    {
      "id": "7.4.8-SN-hyperscale-np7-pba",
      "section": "special_notice",
      "dedupe": "sn:hyperscale-np7-hardware-limitation",
      "title": "Hyperscale の PBA の IP プールでブロックが 1 つしか割り当てられない",
      "summary": "NP7 の制限で、Hyperscale のポリシーでポートブロック割り当て（overload PBA）の IP プールを使うと、クライアントごとに 1 ブロックしか割り当てない。cgn-resource-quota は無視される。ほかの制限は Hyperscale Firewall Guide の incompatibilities and limitations にある。",
      "severity": "medium",
      "when": {
        "path": "firewall ippool[*]",
        "key": "type",
        "op": "eq",
        "value": "cgn-resource-allocation"
      },
      "judge": "auto",
      "impact": "同じサーバーの IP・ポートに多くのセッションを張るクライアントで、ポートの割り当てに失敗することがある。",
      "action": "必要なら IP プールの cgn-block-size を大きくする。Hyperscale を使っているなら、Hyperscale Firewall Guide の制限の一覧も読む。",
      "url": "https://docs.fortinet.com/document/fortigate/7.4.8/fortios-release-notes/974969/hyperscale-np7-hardware-limitation"
    },
    {
      "id": "7.4.8-SN-np7-qos-type",
      "section": "special_notice",
      "dedupe": "sn:changes-to-np7-traffic-shaping",
      "title": "NP7 の default-qos-type を shaping にできなくなる",
      "summary": "NP7 の QTM の不具合が直り、system npu の default-qos-type は policing だけになった。インターフェースのシェーピングプロファイルは QTM を使う。",
      "severity": "high",
      "when": {
        "path": "system npu",
        "key": "default-qos-type",
        "op": "eq",
        "value": "shaping"
      },
      "judge": "auto",
      "impact": "NP7 にオフロードした通信のシェーピングのかかり方が変わる。",
      "action": "ポリシーのシェーピング・IP ごとのシェーピングは TPE、インターフェースのシェーピングプロファイルは QTM になることを踏まえ、帯域制御の結果を確かめる。",
      "url": "https://docs.fortinet.com/document/fortigate/7.4.8/fortios-release-notes/729039/changes-to-np7-traffic-shaping"
    },
    {
      "id": "7.4.8-SN-gui-rsa1024",
      "section": "special_notice",
      "dedupe": "sn:gui-cannot-be-accessed-when-using-a-server-certificate-with-an-rsa-1024-bit-key",
      "introduced": {
        "7.2": "7.2.11",
        "7.4": "7.4.8",
        "7.6": "7.6.1"
      },
      "title": "RSA 1024 ビットの証明書だと GUI に入れなくなる",
      "summary": "7.2.11・7.4.8・7.6.1 から、管理用のサーバー証明書には 2048 ビット以上の RSA の鍵が要る。2048 ビット未満の証明書は使えない。",
      "severity": "high",
      "when": {
        "all": [
          {
            "path": "system global",
            "key": "admin-server-cert",
            "op": "exists"
          },
          {
            "not": {
              "path": "system global",
              "key": "admin-server-cert",
              "op": "in",
              "value": [
                "self-sign",
                "Fortinet_Factory",
                "Fortinet_GUI_Server"
              ]
            }
          }
        ]
      },
      "judge": "manual",
      "impact": "上げたあと、GUI に入れなくなる（CLI は使える）。",
      "action": "上げる前に admin-server-cert の証明書の鍵の長さを確かめ、2048 ビット未満なら作り直して差し替える。",
      "url": "https://docs.fortinet.com/document/fortigate/7.4.8/fortios-release-notes/735344/gui-cannot-be-accessed-when-using-a-server-certificate-with-an-rsa-1024-bit-key"
    },
    {
      "id": "7.4.8-SN-sslvpn-g-entry",
      "section": "special_notice",
      "dedupe": "sn:ssl-vpn-not-supported-on-fortigate-g-series-entry-level-models",
      "introduced": "7.4.8",
      "title": "G シリーズの小型機で SSL VPN が使えない",
      "summary": "50G・70G・90G などの G シリーズの小型機では、SSL VPN の Web モード・トンネルモードが GUI・CLI から無くなる。設定は引き継がれない。",
      "severity": "high",
      "models": {
        "only": [
          "FGT30G",
          "FWF30G",
          "FGT31G",
          "FWF31G",
          "FGT50G",
          "FWF50G",
          "FGT51G",
          "FWF51G",
          "FGR50G",
          "FGT70G",
          "FWF70G",
          "FGT71G",
          "FWF71G",
          "FGR70G",
          "FGT90G",
          "FGT91G"
        ]
      },
      "when": {
        "all": [
          {
            "any": [
              {
                "path": "firewall policy[*]",
                "key": "srcintf",
                "op": "intf_regex",
                "value": "^ssl\\."
              },
              {
                "path": "vpn ssl settings",
                "key": "source-interface",
                "op": "exists"
              }
            ]
          },
          {
            "path": "vpn ssl settings"
          }
        ]
      },
      "judge": "auto",
      "impact": "アップグレード後、SSL VPN のリモートアクセスがつながらなくなる。",
      "action": "上げる前に IPsec ダイヤルアップ VPN へ移行する。Fortinet の「SSL VPN to IPsec VPN migration」を参照。",
      "url": "https://docs.fortinet.com/document/fortigate/7.4.8/fortios-release-notes/205987/ssl-vpn-not-supported-on-fortigate-g-series-entry-level-models"
    },
    {
      "id": "7.4.8-SN-aslr-4gb",
      "section": "special_notice",
      "dedupe": "sn:memory-increase-on-low-end-models-with-4-gb-ram-and-aslr",
      "introduced": {
        "7.4": "7.4.8",
        "7.6": "7.6.4"
      },
      "title": "4GB RAM の小型機で ASLR のためメモリが増える",
      "summary": "4GB RAM の小型機では、ASLR を有効にしたことで、メモリの使用量が平均 7% 増える。",
      "severity": "low",
      "models": {
        "only": [
          "FGT70F",
          "FWF70F",
          "FGT71F",
          "FWF71F",
          "FGT80F",
          "FWF80F",
          "FGT81F",
          "FWF81F"
        ]
      },
      "judge": "auto",
      "impact": "メモリに余裕が無い機器では、コンサーブモードになりやすくなる。",
      "action": "上げる前にメモリの使用率を見ておき、上げたあとも確かめる。",
      "url": "https://docs.fortinet.com/document/fortigate/7.4.8/fortios-release-notes/895445/memory-increase-on-low-end-models-with-4-gb-ram-and-aslr"
    },
    {
      "id": "7.4.8-SN-fg6000-7000",
      "section": "special_notice",
      "dedupe": "sn:fortigate-6000-and-7000-upgrade-information",
      "title": "FortiGate 6000・7000 は専用の注意がある",
      "summary": "6000・7000 シリーズには専用のアップグレード情報と制限がある。グレースフルアップグレードには HA で uninterruptible-upgrade と session-pickup を有効にする。",
      "severity": "high",
      "models": {
        "only": [
          "fg6000_7000"
        ]
      },
      "judge": "manual",
      "impact": "手順を誤ると通信断が起きる。単体や uninterruptible-upgrade 無効の HA では、上げる間しばらく通信が止まる。",
      "action": "リリースノートの「FortiGate 6000 and 7000 upgrade information」と「incompatibilities and limitations」を読む。",
      "url": "https://docs.fortinet.com/document/fortigate/7.4.8/fortios-release-notes/725026/fortigate-6000-and-7000-upgrade-information"
    },
    {
      "id": "7.4.8-UP-2gb-proxy",
      "section": "upgrade",
      "dedupe": "sn:2-gb-ram-fortigate-models-no-longer-support-most-fortios-proxy-related-features",
      "introduced": {
        "7.4": "7.4.4",
        "7.6": "7.6.0"
      },
      "title": "2GB RAM 機でプロキシ系の機能が使えない",
      "summary": "7.4.4 から、2GB 以下の機種（40F・60E・60F・80E・90E 系と FGR-60F の 2GB 版）ではプロキシ系の機能が使えない。",
      "severity": "high",
      "models": {
        "only": [
          "FGT40F",
          "FWF40F",
          "FGT41F",
          "FWF41F",
          "FGT60F",
          "FWF60F",
          "FGT61F",
          "FWF61F",
          "FGR60F",
          "FGT60E",
          "FWF60E",
          "FGT61E",
          "FWF61E",
          "FGT80E",
          "FGT81E",
          "FGT90E",
          "FGT91E"
        ]
      },
      "when": {
        "any": [
          {
            "path": "firewall policy[*]",
            "key": "inspection-mode",
            "op": "eq",
            "value": "proxy"
          },
          {
            "path": "web-proxy explicit",
            "key": "status",
            "op": "eq",
            "value": "enable"
          },
          {
            "path": "firewall proxy-policy[*]"
          }
        ]
      },
      "judge": "auto",
      "impact": "プロキシモードのポリシー・明示プロキシが使えなくなり、検査の方法が変わる（フローベースになる）。",
      "action": "プロキシに頼っている検査（Web フィルタの一部・DLP など）を洗い出し、フローベースで足りるか確かめる。足りなければ上位機種を検討する。",
      "url": "https://docs.fortinet.com/document/fortigate/7.4.8/fortios-release-notes/768039/2-gb-ram-fortigate-models-no-longer-support-fortios-proxy-related-features"
    },
    {
      "id": "7.4.8-UP-fortiswitch-empty-password",
      "section": "upgrade",
      "dedupe": "sn:managed-fortiswitch-do-not-permit-empty-passwords-for-administrator-accounts",
      "introduced": {
        "7.4": "7.4.6",
        "7.6": "7.6.1"
      },
      "title": "管理下の FortiSwitch で空の admin パスワードが使えなくなる",
      "summary": "7.4.6 から、FortiSwitch の admin のパスワードが空だと、FortiGate が無作為のパスワードを付ける。",
      "severity": "high",
      "when": {
        "all": [
          {
            "path": "switch-controller managed-switch[*]"
          },
          {
            "not": {
              "path": "switch-controller switch-profile[*]",
              "key": "login-passwd-override",
              "op": "eq",
              "value": "enable"
            }
          }
        ]
      },
      "judge": "manual",
      "impact": "admin のパスワードが空の FortiSwitch に、直接ログインできなくなる。",
      "action": "各 FortiSwitch に admin のパスワードがあるか確かめる。無ければ switch-profile で login-passwd-override enable と login-passwd を設定する。",
      "url": "https://docs.fortinet.com/document/fortigate/7.4.8/fortios-release-notes/136353/managed-fortiswitch-do-not-permit-empty-passwords-for-administrator-accounts"
    },
    {
      "id": "7.4.8-UP-sdwan-zone-policies",
      "section": "upgrade",
      "dedupe": "sn:policies-that-use-an-interface-show-missing-or-empty-values-after-an-upgrade",
      "introduced": {
        "7.4": "7.4.6",
        "7.6": "7.6.1"
      },
      "title": "SD-WAN ゾーンのメンバーを使うポリシーが消える・空になる",
      "summary": "7.4.5 以前で、SD-WAN ゾーンに入っているインターフェースを local-in ポリシーで使っていると、7.4.6・7.4.7 へ上げたときに消えるか空になる。7.4.8 で直った。経路を飛ばして直接 7.4.8 へ上げればポリシーは残る（推奨はされない）。",
      "severity": "high",
      "when": {
        "all": [
          {
            "path": "system sdwan zone[*]"
          },
          {
            "any": [
              {
                "path": "firewall local-in-policy[*]"
              },
              {
                "path": "firewall DoS-policy[*]"
              },
              {
                "path": "firewall interface-policy[*]"
              },
              {
                "path": "firewall multicast-policy[*]"
              },
              {
                "path": "firewall ttl-policy[*]"
              },
              {
                "path": "firewall central-snat-map[*]"
              }
            ]
          }
        ]
      },
      "judge": "ai",
      "ai": {
        "question": "local-in-policy・DoS-policy・interface-policy・multicast-policy・ttl-policy・central-snat-map のどれかで、system sdwan members に入っているインターフェース（intf / srcintf / dstintf）を直接使っていますか？",
        "context": [
          "system sdwan",
          "firewall local-in-policy",
          "firewall DoS-policy",
          "firewall interface-policy",
          "firewall multicast-policy",
          "firewall ttl-policy",
          "firewall central-snat-map"
        ]
      },
      "impact": "これらのポリシーが消えるか、インターフェースが空になる。",
      "action": "経路どおりに上げたあと、消えたポリシーを作り直し、SD-WAN ゾーンを指定する。",
      "url": "https://docs.fortinet.com/document/fortigate/7.4.8/fortios-release-notes/925230/policies-that-use-an-interface-show-missing-or-empty-values-after-an-upgrade"
    },
    {
      "id": "7.4.8-UP-fips-tacacs",
      "section": "upgrade",
      "dedupe": "sn:fips-cc-mode-no-longer-supports-tacacs",
      "introduced": {
        "7.4": "7.4.8",
        "7.6": "7.6.1"
      },
      "title": "FIPS-CC モードで TACACS+ が使えなくなる",
      "summary": "7.4.8 から、FIPS-CC モードでは TACACS+ が使えない（MD5 を使うため）。7.6.0 以降は RADIUS over TLS だけになる。",
      "severity": "high",
      "when": {
        "path": "user tacacs+[*]"
      },
      "judge": "ai",
      "ai": {
        "question": "FIPS-CC モード（system fips-cc の status enable）で動いていますか？",
        "context": [
          "system fips-cc",
          "user tacacs+"
        ]
      },
      "impact": "TACACS+ で認証している管理者・ユーザーがログインできなくなる。",
      "action": "上げる前に RADIUS など別の認証へ移す。7.6 へ上げるなら RADIUS over TLS にする。",
      "url": "https://docs.fortinet.com/document/fortigate/7.4.8/fortios-release-notes/742775/fips-cc-mode-no-longer-supports-tacacs"
    },
    {
      "id": "7.4.8-UP-loopback-vip",
      "section": "upgrade",
      "dedupe": "sn:loopback-based-vips-cannot-pass-traffic-after-upgrade",
      "introduced": "7.4.8",
      "title": "ループバックを使う VIP で通信が通らなくなる",
      "summary": "7.4.5〜7.4.7 から 7.4.8 以降へ上げるとき、ループバックの IP を外部 IP にした VIP（extintf any）は、入口と出口のポリシーが無いと通信が通らない。",
      "severity": "high",
      "when": {
        "all": [
          {
            "path": "system interface[*]",
            "key": "type",
            "op": "eq",
            "value": "loopback"
          },
          {
            "path": "firewall vip[*]",
            "key": "extintf",
            "op": "eq",
            "value": "any"
          }
        ]
      },
      "judge": "ai",
      "ai": {
        "question": "extintf が any で、extip がループバックのインターフェースの IP と同じ VIP はありますか？",
        "context": [
          "system interface",
          "firewall vip",
          "firewall policy"
        ]
      },
      "impact": "その VIP への通信が止まる。",
      "action": "上げる前に、外側のインターフェース（wan1 など）→ループバックのポリシーと、ループバック→実サーバー側のインターフェースのポリシーを作る。",
      "url": "https://docs.fortinet.com/document/fortigate/7.4.8/fortios-release-notes/659583/loopback-based-vips-cannot-pass-traffic-after-upgrade"
    },
    {
      "id": "7.4.8-UP-vm-memory",
