    {
      "id": "7.4.8-UP-fabric-versions",
      "section": "upgrade",
      "dedupe": "sn:fortinet-security-fabric-upgrade",
      "title": "FortiAnalyzer・FortiManager を先に上げる",
      "summary": "7.4.8 で確かめた組み合わせは FortiAnalyzer・FortiManager 7.4.7。上げる順は FortiAnalyzer → FortiManager → FortiGate → FortiExtender → FortiSwitch → FortiAP。Security Fabric では全部の FortiGate を同じ版にする。",
      "severity": "medium",
      "when": {
        "any": [
          {
            "path": "system central-management",
            "key": "type",
            "op": "eq",
            "value": "fortimanager"
          },
          {
            "path": "log fortianalyzer setting",
            "key": "status",
            "op": "eq",
            "value": "enable"
          },
          {
            "path": "system csf",
            "key": "status",
            "op": "eq",
            "value": "enable"
          }
        ]
      },
      "judge": "manual",
      "impact": "管理側（FortiAnalyzer・FortiManager）が古いと、管理・ログの取り込みがうまくいかないことがある。",
      "action": "FortiAnalyzer・FortiManager の版を確かめ、先に上げておく。Fabric の FortiGate はそろえて上げる。",
      "url": "https://docs.fortinet.com/document/fortigate/7.4.8/fortios-release-notes/936594/fortinet-security-fabric-upgrade"
    },
    {
      "id": "7.4.8-UP-gui-upgrade-path",
      "section": "upgrade",
      "dedupe": "sn:gui-firmware-upgrade-does-not-respect-upgrade-path-in-previous-versions",
      "introduced": "7.4.4",
