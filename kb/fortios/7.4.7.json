    },
    {
      "id": "7.4.7-KI-1164174",
      "section": "known_issue",
      "bug_id": "1164174",
      "title": "60F でエクストリームコンサーブモードになると設定が消える",
      "summary": "FGT-60F がエクストリームコンサーブモードに入ると、設定が失われることがある。",
