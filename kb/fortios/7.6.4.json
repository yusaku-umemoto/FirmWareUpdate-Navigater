      "url": "https://docs.fortinet.com/document/fortigate/7.6.4/fortios-release-notes/725026/fortigate-6000-and-7000-upgrade-information"
    },
    {
      "id": "7.6.4-DB-1099339",
      "section": "default_behavior",
      "bug_id": "1099339",
      "title": "VNE インターフェースの IPv4 アドレスが /32 に限られる",
      "summary": "VNE トンネル（DS-Lite・MAP-E など）のインターフェースの IPv4 アドレスは、ネットマスクが /32 だけになった。",
      "severity": "medium",
      "when": {
        "any": [
          {
            "path": "system vne-tunnel",
            "key": "ipv4-address",
            "op": "regex",
            "value": "^(?!.*(255\\.255\\.255\\.255|/32))(?!0\\.0\\.0\\.0)\\S"
          },
          {
            "path": "system vne-interface[*]",
            "key": "ipv4-address",
            "op": "regex",
            "value": "^(?!.*(255\\.255\\.255\\.255|/32))(?!0\\.0\\.0\\.0)\\S"
          }
        ]
      },
      "judge": "auto",
      "impact": "/32 以外にしていた VNE のアドレスが /32 になり、相手側からそのアドレスへ届かなくなることがある。",
      "action": "VNE トンネルの相手側に、FortiGate の VNE のアドレスへの経路を足す。",
      "url": "https://docs.fortinet.com/document/fortigate/7.6.4/fortios-release-notes/230510/changes-in-default-behavior"
    },
    {
